    {
      "parameters": {
        "jsCode": "let raw = $json.content.parts[0].text.trim();\n\nif (raw.startsWith('```')) {\n  raw = raw.replace(/^```(json)?\\n?/, '').replace(/```\\s*$/, '').trim();\n}\n\nconst parsed = JSON.parse(raw);\n\nreturn [{\n  json: {\n    jobPosting: $node[\"Webhook\"].json.body.jobPosting,\n    questions: parsed.questions,\n    rubric: parsed.rubric\n  }\n}];\n"
      },
