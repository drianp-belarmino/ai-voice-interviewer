        "jsonOutput": true,
        "builtInTools": {},
        "options": {
          "systemMessage": "You score a mock interview transcript against a rubric, exactly like a strict but fair interview coach. For each question in the rubric, in order, score the candidate's answer 0-100 using this guide: 90-100 strong/specific/confident/no fillers/right length, 75-89 good with minor issues, 60-74 passable but vague or wrong length, below 60 needs significant improvement. Output ONLY valid JSON, no markdown fences, no commentary, matching exactly this shape: {\"perQuestion\": [{\"question\": \"...\", \"score\": 0, \"answerLength\": \"too short|ideal|too long\", \"fillerWords\": [\"...\"], \"keyPointsCovered\": \"x/y with which ones\", \"clarity\": \"clear|somewhat vague|unclear\", \"grammar\": \"clean|minor issues: ...\", \"confidenceSignals\": \"strong|weak: ...\", \"biggestFix\": \"...\", \"whatLanded\": \"...\"}], \"overallScore\": 0, \"top3Fixes\": [\"...\", \"...\", \"...\"]}. Match each transcript answer to its question by order. If the candidate skipped a question, score it 0 and note that in biggestFix."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        224,
        0
      ],
      "id": "93953120-fb30-4aa6-99df-b36138b1b2b2",
      "name": "Message a model",
