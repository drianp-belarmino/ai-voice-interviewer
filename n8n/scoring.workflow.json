          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "let raw = $json.content.parts[0].text.trim();\n\nif (raw.startsWith('```')) {\n  raw = raw.replace(/^```(json)?\\n?/, '').replace(/```\\s*$/, '').trim();\n}\n\nconst scorecard = JSON.parse(raw);\n\nreturn [{\n  json: {\n    sessionId: $node[\"Webhook\"].json.body.sessionId,\n    transcript: $node[\"Webhook\"].json.body.transcript,\n    scorecard\n  }\n}];\n"
      },
