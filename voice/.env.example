# Copy this file to .env and fill in the two keys. .env is gitignored.

# From deepgram.com. Account starts with $200 credit, no card required.
DEEPGRAM_API_KEY=

# The same Gemini key already used by the n8n workflows.
GOOGLE_API_KEY=

# Optional overrides. The defaults below are what server.py uses.
# GEMINI_MODEL=gemini-flash-latest
# PIPER_VOICE=en_US-lessac-medium
# N8N_BASE_URL=http://localhost:5678/webhook
# PORT=7860

# How long a silence lasts before the turn machinery considers you might be
# finished. Smart Turn then decides whether you actually are. Raise this if the
# agent still clips you mid-sentence. Pipecat's default is 0.2, which is very
# eager; Vapi needed 4.5 before its own smart endpointing was enabled.
# VAD_STOP_SECS=0.6
